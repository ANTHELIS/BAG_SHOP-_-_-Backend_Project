<%- include('./partials/headerShop') %>

<div class="w-full min-h-screen bg-gray-50 pt-32 pb-12 px-4 sm:px-10">
    <!-- Breadcrumbs -->
    <nav class="flex mb-8 text-sm text-gray-500">
        <a href="/shop" class="hover:text-black transition-colors">Shop</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium"><%= product.name %></span>
    </nav>

    <div class="max-w-7xl mx-auto bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-2">
            <!-- Product Image Section -->
            <div class="h-[50vh] md:h-[70vh] w-full flex items-center justify-center p-8 md:p-16 relative overflow-hidden" 
                 style="background-color: <%= product.bgcolor %>;">
                <img class="w-full h-full object-contain drop-shadow-2xl hover:scale-105 transition-transform duration-500 ease-out"
                     src="data:image/<%= product.imgType %>;base64,<%= product.img.toString('base64') %>"
                     alt="<%= product.name %>"
                     id="mainImage">
                
                <!-- Discount Badge -->
                <% if(product.discount > 0) { %>
                    <div class="absolute top-6 left-6 bg-red-500 text-white px-4 py-1 rounded-full font-bold shadow-lg">
                        <%= product.discount %>₹ OFF
                    </div>
                <% } %>
            </div>

            <!-- Product Details Section -->
            <div class="p-8 md:p-12 flex flex-col h-full bg-white relative">
                
                <h1 class="text-3xl md:text-5xl font-extrabold text-zinc-900 mb-4 tracking-tight leading-tight">
                    <%= product.name %>
                </h1>

                <div class="flex items-baseline gap-3 mb-8">
                    <% var discountedPrice = product.price - product.discount %>
                    <span class="text-3xl font-bold text-gray-900">₹ <%= discountedPrice %></span>
                    <% if(product.discount > 0) { %>
                        <span class="text-xl text-gray-400 line-through">₹ <%= product.price %></span>
                    <% } %>
                </div>

                <!-- Static Rating (Placeholder) -->
                <!-- <div class="flex items-center bg-red-500 gap-2 mb-8">
                    <div class="flex text-yellow-400">
                        <i class="ri-star-fill"></i>
                        <i class="ri-star-fill"></i>
                        <i class="ri-star-fill"></i>
                        <i class="ri-star-fill"></i>
                        <i class="ri-star-half-fill"></i>
                    </div>
                    <span class="text-sm text-gray-500">(128 reviews)</span>
                </div> -->

                <!-- Highlights & Services -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-6 mb-8">
                    <% if(product.highlights.length > 0){ %>
                        <div>
                            <h3 class="font-bold text-gray-400 text-xs uppercase tracking-wider mb-2">Highlights</h3>
                            <ul class="space-y-2 text-sm text-gray-600">
                                <% product.highlights.forEach((highlight)=>{ %>
                                    <li class="flex items-start gap-2">
                                        <span class="w-1.5 h-1.5 rounded-full bg-gray-400 mt-1.5 flex-shrink-0"></span>
                                        <%= highlight %>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>
                    <% } %>
                    <div>
                        <h3 class="font-bold text-gray-400 text-xs uppercase tracking-wider mb-2">Services</h3>
                        <ul class="space-y-2 text-sm text-gray-600">
                            <li class="flex items-center gap-2">
                                <i class="ri-shield-check-line text-blue-500"></i> 
                                <span><%= product.warrantyInYear %> Year Warranty</span>
                            </li>
                            <li class="flex items-center gap-2">
                                <i class="ri-hand-coin-line text-blue-500"></i> 
                                <span>Cash on Delivery</span>
                            </li>
                            <li class="flex items-center gap-2">
                                <i class="ri-truck-line text-blue-500"></i> 
                                <span>Fast Shipping</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Seller Info -->
                <div class="flex items-center gap-3 mb-8 p-3 bg-gray-50 rounded-lg border border-gray-100">
                    <span class="text-sm text-gray-500 w-16">Seller</span>
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-blue-600 text-sm">BaggyOfficial</span>
                        <span class="bg-blue-600 text-white text-[10px] px-1.5 py-0.5 rounded flex items-center gap-0.5">
                            4.5 <i class="ri-star-fill text-[8px]"></i>
                        </span>
                    </div>
                </div>

                <div class="mt-auto border-t border-gray-100 pt-8">
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="/addtocart/<%= product._id %>" 
                           class="flex-1 bg-black text-white text-center py-4 rounded-xl font-bold text-lg hover:bg-gray-900 transition-all hover:shadow-lg active:scale-95 flex items-center justify-center gap-2">
                            <i class="ri-shopping-cart-2-line"></i>
                            Add to Cart
                        </a>
                        <button class="w-full sm:w-16 h-14 border border-gray-200 rounded-xl flex items-center justify-center hover:border-gray-900 hover:text-red-500 transition-all active:scale-95">
                            <i class="ri-heart-line text-2xl"></i>
                        </button>
                    </div>
                    
                    <div class="flex items-center gap-6 mt-6 text-sm text-gray-500 justify-center sm:justify-start">
                        <div class="flex items-center gap-2">
                            <i class="ri-truck-line text-lg"></i> Free Shipping
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="ri-shield-check-line text-lg"></i> <%= product.warrantyInYear %> Year Warranty
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto mt-8 grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Main Content Column -->
        <div class="lg:col-span-4 space-y-8">
            
            <!-- Product Description -->
            <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100">
                <h3 class="text-xl font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">Product Description</h3>
                <div class="text-gray-600 leading-relaxed text-sm md:text-base space-y-4">
                    <%= product.description %>
                </div>
            </div>

            <!-- Specifications -->
            <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
                <div class="px-6 md:px-8 py-4 border-b border-gray-100">
                    <h3 class="text-xl font-bold text-gray-900">Specifications</h3>
                </div>
                <div class="p-6 md:p-8">
                    <h4 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">General</h4>
                    <div class="divide-y divide-gray-100 border border-gray-100 rounded-lg overflow-hidden">
                        <div class="grid grid-cols-3 p-4 bg-gray-50/50">
                            <div class="text-gray-500 text-sm font-medium">Brand</div>
                            <div class="col-span-2 text-gray-900 text-sm font-semibold">Baggy</div>
                        </div>
                        <div class="grid grid-cols-3 p-4">
                            <div class="text-gray-500 text-sm font-medium">Model Name</div>
                            <div class="col-span-2 text-gray-900 text-sm font-semibold"><%= product.name %></div>
                        </div>
                        <div class="grid grid-cols-3 p-4 bg-gray-50/50">
                            <div class="text-gray-500 text-sm font-medium">Color</div>
                            <div class="col-span-2 text-gray-900 text-sm font-semibold flex items-center gap-2">
                                <!-- <span class="w-4 h-4 rounded-full border border-gray-200" style="background-color: <%= product.panelcolor %>"></span> -->
                                <%= product.specification.color %>
                            </div>
                        </div>
                        <div class="grid grid-cols-3 p-4">
                            <div class="text-gray-500 text-sm font-medium">Material</div>
                            <div class="col-span-2 text-gray-900 text-sm font-semibold"><%= product.specification.material %></div>
                        </div>
                        <div class="grid grid-cols-3 p-4 bg-gray-50/50">
                            <div class="text-gray-500 text-sm font-medium">Type</div>
                            <div class="col-span-2 text-gray-900 text-sm font-semibold"><%= product.specification.categoryType %></div>
                        </div>
                        <div class="grid grid-cols-3 p-4">
                            <div class="text-gray-500 text-sm font-medium">Capacity</div>
                            <div class="col-span-2 text-gray-900 text-sm font-semibold"><%= product.specification.capacity %></div>
                        </div> 
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products Placeholder -->
    <div class="max-w-7xl mx-auto mt-20">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">You might also like</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
            <!-- This would normally loop through related products -->
            <div class="bg-white rounded-xl p-4 border border-gray-100 opacity-50 text-center py-12">
                <i class="ri-shopping-bag-line text-4xl text-gray-300 mb-2"></i>
                <p class="text-gray-400">Related products coming soon</p>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>