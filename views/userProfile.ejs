<%- include('./partials/headerShop') %>
    <div class="w-full min-h-screen bg-gray-50 pt-24 pb-10 px-4 sm:px-10 flex justify-center">
        <div class="w-full max-w-4xl bg-white rounded-2xl shadow-lg overflow-hidden">
            <form id="profileForm" action="/profile/edit" method="post" enctype="multipart/form-data">
                <div class="bg-blue-600 h-32 w-full relative">
                    <div class="absolute -bottom-16 left-8 sm:left-12">
                        <!-- Profile Image Container -->
                        <div class="w-32 h-32 rounded-full border-4 border-white bg-white overflow-hidden shadow-md relative group cursor-pointer" 
                             onclick="triggerFileInput(event)">
                            
                            <input id="profilePicInput" name="userPic" type="file" class="hidden" accept="image/*" onchange="previewImage(event)">
                            
                            <!-- Hover Overlay -->
                            <div class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity z-10">
                                <i class="ri-camera-line text-white text-2xl"></i>
                            </div>

                            <!-- Image Display -->
                            <% if(user.img && user.imgType){ %>
                                <img id="profilePreview" class="h-full w-full object-cover" 
                                     src="data:image/<%=user.imgType%>;base64,<%= user.img.toString('base64') %>" 
                                     alt="Profile">
                            <% } else{ %>
                                <img id="profilePreview" class="h-full w-full object-cover" 
                                     src="/images/profile/userPic.jpg" 
                                     alt="Profile">
                            <% } %>
                        </div>
                    </div>
                </div>
                
                <div class="pt-20 px-8 sm:px-12 pb-12">
                    <div class="flex justify-between items-center mb-8">
                        <div>
                            <h1 class="text-3xl font-bold text-gray-800"><%= user.fullname %></h1>
                            <p class="text-gray-500"><%= user.email %></p>
                        </div>
                    </div>                    

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="md:col-span-2">
                            <h3 class="text-lg font-semibold text-gray-800 border-b pb-2 mb-4">Personal Information</h3>
                        </div>
                        
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                            <input class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" 
                                type="text" placeholder="Fullname" name="fullname" value="<%= user.fullname %>">
                        </div>

                        <div class="md:col-span-2">
                            <h3 class="text-lg font-semibold text-gray-800 border-b pb-2 mb-4 mt-4">Address Details</h3>
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Flat / House / Building</label>
                            <input class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" 
                                type="text" placeholder="Flat/House/building name" name="flat" value="<%= user.address ? user.address.flat : '' %>">
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Area / Locality</label>
                            <input class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" 
                                type="text" placeholder="Area/Sector/Locality" name="area" value="<%= user.address ? user.address.area : '' %>">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">City</label>
                            <input class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" 
                                type="text" placeholder="City" name="city" value="<%= user.address ? user.address.city : '' %>">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
                            <input class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" 
                                type="text" placeholder="State" name="state" value="<%= user.address ? user.address.state : '' %>">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Pincode</label>
                            <input class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" 
                                type="text" placeholder="Pincode" name="pincode" value="<%= user.address ? user.address.pincode : '' %>">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Contact Number</label>
                            <input class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" 
                                type="text" placeholder="10-digit mobile number" name="contact" value="<%= user.address ? user.address.contact : '' %>">
                        </div>
                    </div>

                    <div class="flex justify-end pt-6">
                        <button class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200" type="submit">
                            Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script>
        function triggerFileInput(event) {
            // Prevent recursive triggering if the file input or its children are clicked directly
            if (event.target.tagName !== 'INPUT') {
                document.getElementById('profilePicInput').click();
            }
        }

        function previewImage(event) {
            const file = event.target.files?.[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('profilePreview');
                    img.src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        }
    </script>
    <%- include('./partials/footer') %>