<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style> @import url('https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Pacifico&display=swap');</style>
</head>

<body class="font-['Google Sans']">
    <nav class="w-full fixed top-0 left-0 px-5 py-3 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
        <div class="flex justify-between items-center relative">
            <h3 class="font-['Pacifico'] text-2xl text-blue-600">Baggy</h3>
            
            <!-- Desktop Menu -->
            <div class="hidden md:flex gap-4">
                <a href="/" class="text-sm font-medium text-gray-700 hover:text-blue-600 transition-colors">Register</a>
                <a href="/login" class="text-sm font-medium text-gray-700 hover:text-blue-600 transition-colors">Login</a>
            </div>

            <!-- Mobile Menu Button -->
            <button id="mobile-menu-btn" class="md:hidden text-gray-700 hover:text-blue-600 focus:outline-none">
                <i class="ri-menu-line text-2xl"></i>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden w-full absolute top-full left-0 bg-white border-b border-gray-100 shadow-lg py-4 px-5 flex-col gap-4">
            <a href="/" class="block w-full text-base font-medium text-gray-700 hover:text-blue-600 transition-colors py-2 border-b border-gray-50">Register</a>
            <a href="/login" class="block w-full text-base font-medium text-gray-700 hover:text-blue-600 transition-colors py-2">Login</a>
        </div>
    </nav>
    <script>
        document.getElementById('mobile-menu-btn').addEventListener('click', function() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
            const icon = this.querySelector('i');
            if (menu.classList.contains('hidden')) {
                icon.classList.remove('ri-close-line');
                icon.classList.add('ri-menu-line');
            } else {
                icon.classList.remove('ri-menu-line');
                icon.classList.add('ri-close-line');
            }
        });
    </script>
