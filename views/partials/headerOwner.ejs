<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style> @import url('https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Pacifico&display=swap');</style>
</head>

<body class="font-['Google Sans']">
    <nav class="w-full fixed top-0 left-0 px-5 py-3 z-50 bg-gray-900 text-white shadow-md transition-all duration-300">
        <div class="flex justify-between items-center relative">
            <div class="flex items-center gap-3">
                <h3 class="font-['Pacifico'] text-2xl text-white hover:scale-105 transition-transform cursor-pointer"><a href="/owners/admin/products">Baggy</a></h3>
                <span class="px-2 py-0.5 rounded bg-gray-700 text-xs font-semibold text-gray-300 uppercase tracking-wider">Admin</span>
            </div>

            <!-- Desktop Menu -->
            <div class="hidden md:flex items-center gap-6">
                <a href="/owners/admin/products" class="text-sm font-medium text-gray-300 hover:text-white transition-colors relative group">
                    Dashboard
                    <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-white transition-all group-hover:w-full"></span>
                </a>
                <a href="/owners/admin" class="text-sm font-medium text-gray-300 hover:text-white transition-colors relative group">
                    Add Product
                    <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-white transition-all group-hover:w-full"></span>
                </a>
                <a href="/owners/admin/orders" class="text-sm font-medium text-gray-300 hover:text-white transition-colors relative group">
                    Orders
                    <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-white transition-all group-hover:w-full"></span>
                </a>
                <a href="/owners/admin/profile" class="text-sm font-medium text-gray-300 hover:text-white transition-colors relative group">
                    My Account
                    <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-white transition-all group-hover:w-full"></span>
                </a>
                <a class="px-4 py-2 rounded-full bg-red-600 text-white text-sm font-medium hover:bg-red-700 transition-colors shadow-sm" href="/owners/logout">Logout</a>
            </div>

            <!-- Mobile Menu Button -->
            <button id="mobile-menu-btn" class="md:hidden text-white hover:text-gray-300 focus:outline-none">
                <i class="ri-menu-line text-2xl"></i>
            </button>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden w-full absolute top-full left-0 bg-gray-900 border-b border-gray-800 shadow-xl py-4 px-5 flex-col gap-4">
            <a href="/owners/admin/products" class="block w-full text-base font-medium text-gray-300 hover:text-white transition-colors py-2 border-b border-gray-800">Dashboard</a>
            <a href="/owners/admin" class="block w-full text-base font-medium text-gray-300 hover:text-white transition-colors py-2 border-b border-gray-800">Add Product</a>
            <a href="/owners/admin/orders" class="block w-full text-base font-medium text-gray-300 hover:text-white transition-colors py-2 border-b border-gray-800">Orders</a>
            <a href="/owners/admin/profile" class="block w-full text-base font-medium text-gray-300 hover:text-white transition-colors py-2 border-b border-gray-800">My Account</a>
            <a href="/owners/logout" class="block w-full text-base font-medium text-red-500 hover:text-red-400 transition-colors py-2">Logout</a>
        </div>
    </nav>
    <script>
        document.getElementById('mobile-menu-btn').addEventListener('click', function() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
            const icon = this.querySelector('i');
            if (menu.classList.contains('hidden')) {
                icon.classList.remove('ri-close-line');
                icon.classList.add('ri-menu-line');
            } else {
                icon.classList.remove('ri-menu-line');
                icon.classList.add('ri-close-line');
            }
        });
    </script>
