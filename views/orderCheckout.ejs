<%- include('./partials/headerShop') %>
        <div class="w-full min-h-screen bg-gray-50 pt-24 pb-10 px-4 sm:px-10">
            <form action="/placeorder" method="post" id="orderForm" class="w-full">
                <div class="flex flex-col lg:flex-row gap-8 items-start">
                    <div class="w-full lg:w-[65%]">
                        <h1 class="text-2xl font-bold uppercase text-gray-800 mb-5">Personal Information</h1>
                        <input class="w-full px-4 py-2 mb-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" type="text" placeholder="Fullname" name="fullname" value="<%= user.fullname %>" required>
                        
                        <h1 class="text-2xl font-bold uppercase text-gray-800 mb-5 mt-6">Shipping Address</h1>
                        <input class="w-full px-4 py-2 mb-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" type="text" placeholder="Flat/House/building name" name="flat" value="<%= user.address.flat %>" required>
                        <input class="w-full px-4 py-2 mb-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" type="text" placeholder="Area/Sector/Locality" name="area" value="<%= user.address.area %>" required>
                        <input class="w-full px-4 py-2 mb-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" type="text" placeholder="City" name="city" value="<%= user.address.city %>" required>
                        <input class="w-full px-4 py-2 mb-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" type="text" placeholder="State" name="state" value="<%= user.address.state %>" required>
                        <input class="w-full px-4 py-2 mb-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" type="number" placeholder="Pincode" name="pincode" value="<%= user.address.pincode %>" required>
                        <input class="w-full px-4 py-2 mb-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" type="tel" placeholder="10-digit mobile number" name="contact" value="<%= user.address.contact %>" maxlength="10" required>
                    </div>
                </div>
                
                <h1 class="text-2xl font-bold uppercase text-gray-800 mb-8 mt-8">Order Summary</h1>
                <div class="flex flex-col lg:flex-row gap-8 items-start">
                    <!-- Cart Items -->
                    <div class="w-full lg:w-[65%] flex flex-col gap-4">
                        <% user.cart.forEach((item)=>{ %>
                            <% const product = item.product %>
                            <div class="flex flex-col sm:flex-row items-center bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden p-4 gap-4 transition-all hover:shadow-md">
                                <div class="w-full sm:w-32 h-32 flex-shrink-0 flex items-center justify-center bg-[<%= product.bgcolor %>] rounded-lg">
                                    <img class="h-24 object-contain" src="data:image/<%=product.imgType%>;base64,<%= product.img.toString('base64') %>" alt="<%= product.name %>">
                                </div>
                                
                                <div class="flex-grow w-full flex flex-col justify-between h-full gap-2">
                                    <div class="flex justify-between items-start">
                                        <h3 class="text-xl font-semibold text-gray-800"><%= product.name %></h3>
                                    </div>
                                    
                                    <div class="flex justify-between items-end mt-2">
                                        <div class="flex items-center gap-3 bg-gray-50 rounded-lg p-1 border border-gray-200">
                                            <span class="font-medium text-gray-700 px-3">Qty: <%= item.quantity %></span>
                                        </div>
                                        
                                        <div class="text-right">
                                            <div class="flex items-baseline gap-2 justify-end">
                                                <span class="text-lg font-bold text-gray-900">₹ <%= (product.price - product.discount) * item.quantity %></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <!-- Order Summary -->
                    <div class="w-full lg:w-[35%] sticky top-24">
                        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-6">Order Summary</h3>
                            
                            <% var totalPrice = 0 %>
                            <% var totalDiscount = 0 %>
                            <% user.cart.forEach((item)=>{ %>
                                <% totalPrice = totalPrice + (item.product.price * item.quantity) %>
                                <% totalDiscount = totalDiscount + (item.product.discount * item.quantity) %>
                            <% }) %>
                            
                            <div class="space-y-3 mb-6">
                                <div class="flex justify-between text-gray-600">
                                    <span>Total MRP</span>
                                    <span>₹ <%= totalPrice %></span>
                                </div>
                                <div class="flex justify-between text-green-600">
                                    <span>Discount on MRP</span>
                                    <span>- ₹ <%= totalDiscount %></span>
                                </div>
                                <div class="flex justify-between text-gray-600">
                                    <span>Platform Fee</span>
                                    <span>₹ 20</span>
                                </div>
                                <div class="flex justify-between text-gray-600">
                                    <span>Shipping Fee</span>
                                    <span class="text-green-600">FREE</span>
                                </div>
                            </div>
                            
                            <div class="border-t border-dashed border-gray-200 pt-4 mb-6">
                                <div class="flex justify-between items-center">
                                    <span class="text-lg font-bold text-gray-800">Total Amount</span>
                                    <span class="text-xl font-bold text-gray-900">₹ <%= totalPrice - totalDiscount + 20 %></span>
                                </div>
                            </div>
                            
                            <button type="submit" class="w-full py-3 bg-black text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors shadow-md hover:shadow-lg transform hover:-translate-y-0.5 duration-200">
                                Place Order
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <%- include('./partials/footer') %>